generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  avatarKey    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  roomPlayers RoomPlayer[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

enum RoomStatus {
  WAITING
  IN_PROGRESS
  CLOSED
}

model Room {
  id        String     @id @default(uuid())
  code      String     @unique
  status    RoomStatus @default(WAITING)
  hostId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  players RoomPlayer[]
  game    Game?
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
}

model Game {
  id        String     @id @default(uuid())
  roomId    String     @unique
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status    GameStatus @default(IN_PROGRESS)
  // Serialized engine GameState (packages/engine) - the server-authoritative source of truth.
  state     Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model RoomPlayer {
  id       String   @id @default(uuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat     Int
  isHost   Boolean  @default(false)
  joinedAt DateTime @default(now())

  // AI seats still get a real (synthetic) User row — reuses every existing
  // join/leave/display-name/engine-player code path unchanged. These two
  // fields are the only thing that marks a seat as bot-controlled.
  isBot         Boolean @default(false)
  botDifficulty String?

  @@unique([roomId, userId])
  @@unique([roomId, seat])
  @@index([userId])
}
