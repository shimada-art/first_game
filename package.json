{
  "name": "souk-el-kdoub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev:client": "pnpm --filter @souk/client run dev",
    "dev:server": "pnpm --filter @souk/server run dev",
    "db:generate": "pnpm --filter @souk/db run generate",
    "db:migrate:dev": "pnpm --filter @souk/db run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @souk/db run migrate:deploy",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@prisma/client", "@prisma/engines", "prisma"]
  }
}
